{
  "name": "angular",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "angular/src",
  "prefix": "forge",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular-vite:start-storybook",
      "continuous": true,
      "options": {
        "configDir": "angular/.storybook",
        "port": 6006,
        "tsConfig": "angular/.storybook/tsconfig.json"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular-vite:build-storybook",
      "outputs": ["{workspaceRoot}/dist/storybook/angular"],
      "options": {
        "configDir": "angular/.storybook",
        "outputDir": "dist/storybook/angular",
        "tsConfig": "angular/.storybook/tsconfig.json"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "angular/ng-package.json",
        "tsConfig": "angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
